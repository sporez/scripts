{
  "name": "web-search-pi",
  "version": "1.0.0",
  "description": "Pi configuration with web search extension",
  "dependencies": {
    "web-search": "file:./web-search-extension.ts"
  },
  "env": {
    "WEB_SEARCH_PROVIDER": "duckduckgo",
    "WEB_SEARCH_CUSTOM_URL": "https://api.example.com/search",
    "WEB_SEARCH_CUSTOM_API_KEY": "env:MY_API_KEY"
  },
  "aliases": {
    "pi": "pi"
  },
  "default": {
    "model": "claude-3.5-sonnet",
    "context": 128000,
    "maxTokens": 8192
  },
  "tools": {
    "read": {
      "enabled": true
    },
    "bash": {
      "enabled": true
    },
    "edit": {
      "enabled": true
    },
    "write": {
      "enabled": true
    }
  }
}